{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diffdrop",
  "mainBinaryName": "diffdrop",
  "version": "0.1.0",
  "identifier": "com.diffdrop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Compare two text files",
    "longDescription": "diffdrop compares two text files side by side, highlighting the lines and words that changed.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright © 2026 Francesco",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "Compare two text files",
      "args": [
        { "name": "fileA", "index": 1, "takesValue": true, "description": "Original file (A)" },
        { "name": "fileB", "index": 2, "takesValue": true, "description": "Modified file (B)" }
      ]
    }
  }
}
